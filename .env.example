# Frontend (safe to expose; protected by RLS)
NG_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NG_APP_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Free PrimeUI Community License key (https://primeui.dev/licenses/community), renewed yearly
NG_APP_PRIMEUI_LICENSE=

# Scripts and GitHub Actions ONLY. Never in frontend code, never committed.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
OWNER_USER_ID=UUID-OF-YOUR-SUPABASE-USER

# Backup encryption (public key only goes in the repo secrets; keep the private key offline)
BACKUP_AGE_RECIPIENT=age1xxxxxxxx
