# Copy to scripts/.env.prod (git-ignored) and fill in; then: chmod 600 .env.prod
# Used by `python -m tools.run_prod <job>` to run a job against production.
# Supabase dashboard › Project Settings › API (URL) and API Keys (secret key, sb_secret_...).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for the backup job: the age public key (age1...). The file lands in BACKUP_DIR.
BACKUP_AGE_RECIPIENT=
# BACKUP_DIR=backup-out
