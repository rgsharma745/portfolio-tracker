{
  "name": "portfolio-tracker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env": "node scripts/set-env.mjs",
    "prestart": "npm run env",
    "start": "ng serve",
    "start:local": "node scripts/set-env.mjs --local && ng serve --configuration local --port 4300",
    "db:start": "node scripts/local-stack.mjs start",
    "db:reset": "node scripts/local-stack.mjs reset",
    "db:stop": "node scripts/local-stack.mjs stop",
    "local:user": "node scripts/local-user.mjs",
    "prebuild": "npm run env",
    "build": "ng build",
    "postbuild": "node scripts/write-headers.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run env",
    "test": "ng test --watch=false && npm run test:worker",
    "test:watch": "ng test",
    "pretest:coverage": "npm run env",
    "test:coverage": "ng test --watch=false --configuration coverage",
    "pretest:sonar": "npm run env",
    "test:sonar":"ng test --watch=false --configuration sonar",
    "test:worker": "vitest run --config worker/vitest.config.mts",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "prelint": "npm run env",
    "lint": "ng lint && npm run typecheck:worker && prettier --check \"src/**/*.{ts,html,scss,css}\" \"e2e/**/*.ts\" \"worker/**/*.{ts,mts}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css}\" \"e2e/**/*.ts\" \"worker/**/*.{ts,mts}\"",
    "e2e": "playwright test",
    "gen:types": "cd .. && npx -y supabase@3.0.0 gen types typescript --local --schema public > web/src/app/core/db.types.ts && cd web && prettier --write src/app/core/db.types.ts"
  },
  "private": true,
  "packageManager": "npm@11.21.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@primeuix/themes": "^3.1.0",
    "@supabase/auth-js": "^2.119.0",
    "@supabase/postgrest-js": "^2.119.0",
    "chart.js": "^4.6.1",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.4",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
